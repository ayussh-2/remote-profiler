# ─── Sensor-Relayer environment variables ───────────────────────────────────
# Copy this file to .env and fill in the values.

# Address the relay HTTP server listens on (default: :5001)
RELAYER_ADDR=:5001

# Full URL of the ML backend endpoint that accepts frame + depth
# (matches /stream/frame in backend/routes/stream.py)
BACKEND_URL=http://localhost:5000/stream/frame

# Maximum timestamp difference between a frame and a depth sample
# for them to be considered temporally aligned.
# Go duration string: 100ms, 300ms, 1s …
FUSE_WINDOW=300ms

# How long to keep a frame before discarding it if no depth arrives.
MAX_FRAME_AGE=2s

# HTTP timeout when forwarding the fused payload to the backend.
FORWARD_TIMEOUT=5s

# Number of parallel goroutines that forward payloads to the backend.
WORKER_COUNT=4

# Internal channel buffer size between the fusion step and forwarders.
QUEUE_SIZE=64
